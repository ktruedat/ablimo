# Rust / Cargo
/target/
**/*.rs.bk
*.pdb

# Lockfile: keep it (this is an app/workspace, not a published library)
# Cargo.lock is intentionally NOT ignored.

# IDEs / editors
/.idea/
/.vscode/
*.iml

# macOS
.DS_Store

# Secrets / credentials — never commit tokens
.env
.env.*
*.token

# Python (QLoRA training handoff in a later phase)
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Model weights / adapters / datasets (large, regenerated by scripts)
/models/
/adapters/
/checkpoints/
*.safetensors
*.gguf
*.bin

# Datasets: downloaded raw corpora (large, licensed, re-downloadable)
/data/raw/

# Generated data & run artifacts
/data/processed/
/data/poisoned/
/data/eval/
/predictions/
*.jsonl
*.zip
canary_marker.txt

# Logs
*.log
